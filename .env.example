# ==========================================
# VERA - Concordium Trusted Agents Environment
# ==========================================

# Servidor y API Core
PORT=8086
HOST=0.0.0.0
APP_ENV=development
API_AUTH_TOKEN=your_secure_random_api_token_here

# Concordium Testnet Node & gRPC
CONCORDIUM_GRPC_HOST=grpc.testnet.concordium.com
CONCORDIUM_GRPC_PORT=20000
CONCORDIUM_NETWORK=testnet

# Concordium Wallet / Cuentas de Agente (Ficticio para ejemplo)
CONCORDIUM_AGENT_ACCOUNT_ADDRESS=4xTestAccountAddressConcordiumExampleOnly111111111
CONCORDIUM_AGENT_PRIVATE_KEY_PATH=./keys/concordium_agent_testnet.export

# Contratos Inteligentes Desplegados (Índices y Subíndices)
CONCORDIUM_EVIDENCE_REGISTRY_INDEX=1000
CONCORDIUM_EVIDENCE_REGISTRY_SUBINDEX=0
CONCORDIUM_REWARD_POOL_INDEX=1001
CONCORDIUM_REWARD_POOL_SUBINDEX=0
CONCORDIUM_CIS8004_INDEX=1002
CONCORDIUM_CIS8004_SUBINDEX=0
CONCORDIUM_CIS8_INDEX=1003
CONCORDIUM_CIS8_SUBINDEX=0

# Configuración de Base de Datos (Opcional MySQL remoto; por defecto usa SQLite local)
USE_SQLITE=true
SQLITE_DB_PATH=./vera_storage.db

# Configuración Base de Datos Remota (Valores de plantilla genéricos)
DB_HOST=db.example.internal
DB_USER=sample_user
DB_PASSWORD=sample_password
DB_NAME=sample_db
DB_PORT=3306

# Túnel SSH (si aplica conexión remota de base de datos)
USE_SSH_TUNNEL=false
SSH_HOST=ssh.example.internal
SSH_PORT=22
SSH_USER=sample_ssh_user
SSH_KEY_PATH=/path/to/sample_private_key.pem
SSH_HOST_KEY=sample_passphrase

# ==========================================
# VERA Core - Políticas, Escenarios y Agente
# ==========================================
VERA_AGENT_ID=vera-agent-demo-01
VERA_AGENT_DISPLAY_NAME=VERA Agente Ambiental Verificable
VERA_POLICY_VERSION=vera-policy-v1
VERA_REFERENCE_TIME=2026-11-25T12:00:00Z

# Reglas deterministas del Policy Engine
VERA_MIN_COVERAGE_RATIO=0.85
VERA_EXPECTED_BATCH_READINGS=48
VERA_MAX_CALIBRATION_AGE_HOURS=720
VERA_REQUIRE_RECOVERY_FOR_ANOMALY=true

# Escenario Home Air (MQ-135 señal cruda ADC, NO CO2 certificado)
VERA_HOME_DEVICE_ID=esp32-mq135-demo-01
VERA_HOME_SENSOR_MODEL=MQ-135
VERA_HOME_FIRMWARE_VERSION=vera-fw-1.0.0
VERA_HOME_LOCATION_LABEL=home-living-room
VERA_HOME_AIR_INTERVAL_MINUTES=30
VERA_HOME_AIR_BASELINE_RAW=325.0
VERA_HOME_AIR_BASELINE_MAX_RAW=380.0
VERA_HOME_AIR_ANOMALY_PEAK_RAW=650.0
VERA_HOME_AIR_ANOMALY_MIN_RAW=520.0
VERA_HOME_AIR_RECOVERY_RAW=335.0
VERA_HOME_AIR_RECOVERY_MAX_RAW=390.0

# Escenario Business (Datos sintéticos declarados - 4 zonas)
VERA_BUSINESS_ORG_ID=org-demo-enterprise-01
VERA_BUSINESS_ORG_NAME=Empresa Demo Sostenible
VERA_BUSINESS_GENERATOR_VERSION=vera-synth-v1
VERA_BUSINESS_ZONES=Oficinas,Producción,Bodega,Logística
VERA_BUSINESS_GRID_EMISSION_FACTOR_KG_PER_KWH=0.164
VERA_BUSINESS_MAX_INTENSITY_KG_PER_UNIT=0.45
VERA_BUSINESS_MIN_REDUCTION_PCT=5.0
VERA_BUSINESS_ZONE_BASELINE_KWH=1200,4800,1600,2400
VERA_BUSINESS_ZONE_CURRENT_KWH=1050,4200,1440,2100
VERA_BUSINESS_ZONE_UNITS=900,2100,1100,1450

# Liquidación / Recompensas Concordium (Testnet)
VERA_REWARD_AMOUNT_MICRO_CCD=1000000
VERA_BUSINESS_REWARD_AMOUNT_MICRO_CCD=2500000
