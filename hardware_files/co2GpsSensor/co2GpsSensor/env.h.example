#ifndef ENV_H
#define ENV_H

// ==========================================================
// VERA IoT Node Configuration Template (ESP8266 + MQ-135 + GPS)
// Copia este archivo como `env.h` en este mismo directorio y
// reemplaza los valores genéricos antes de compilar.
// Nunca subas `env.h` con credenciales reales al repositorio.
// ==========================================================

// Credenciales Wi-Fi
const char* ssid = "YOUR_WIFI_SSID";
const char* password = "YOUR_WIFI_PASSWORD";

// Endpoint HTTP POST de telemetría del backend VERA
const char* SERVER_URL = "http://your-vera-host.example.internal:8086/api/telemetry";

// Token Bearer (debe coincidir con API_AUTH_TOKEN en el .env del servidor)
const char* API_TOKEN = "your_secure_random_api_token_here";

// Identificador único del nodo físico
const char* DEVICE_ID = "esp8266-mq135-demo-01";

#endif // ENV_H
